---
// src/pages/expertise.astro
import MainLayout from '../layouts/MainLayout.astro';

const pageTitle = 'Expertise — Yves Cavarec | Ycompris';
const pageDescription =
  "Parcours et expertise d'Yves Cavarec : transformation d'entreprises, excellence opérationnelle, pivot vers la gouvernance de l'IA (Garder la main).";
const canonical = 'https://ycompris.com/expertise/';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <header class="page-hero container">
    <h1>Expertise</h1>
    <p class="lead" style="color: black;">
      Une trajectoire de transformation et d'excellence opérationnelle — aujourd'hui au service d'une gouvernance IA
      lucide, dans la lignée de <em>Garder la main</em>.
    </p>
  </header>

  <main>
    <section class="section container">
      <h2>Ce que j'apporte</h2>
      <p>
        Clarifier les décisions humaines face à l'IA, cartographier dépendances et risques, produire des analyses
        actionnables — et, à terme, un outil ou service clé en main. Pas un catalogue réglementaire en vitrine.
      </p>
      <ul>
        <li><strong>Lucidité</strong> — nommer ce que l'IA change dans la gouvernance, les compétences, la dépendance aux
          modèles et aux cloud.</li>
        <li><strong>Méthode</strong> — structurer, prioriser, documenter sans lourdeur de grand cabinet.</li>
        <li><strong>Preuves</strong> — études et écrits publics (livre, CAC40, presse), pas une liste de clients inventés.</li>
      </ul>
    </section>

    <section class="section section--alt container" id="fondateur">
      <h2>Yves Cavarec, fondateur d'Ycompris</h2>
      <div class="founder-bio">
        <div class="protected-portrait">
          <div class="photo-bg"></div>
          <img
            src="/images/Yves-Cavarec-CSRD-VSME-Bretagne.png"
            alt="Yves Cavarec — fondateur Ycompris, auteur de Garder la main"
            style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); opacity: 0;"
            aria-hidden="true"
          />
          <div class="photo-overlay"></div>
        </div>

        <div class="founder-text">
          <p>
            Quinze ans dans la transformation de grandes entreprises — gestion de projet, programme et portefeuille
            (référentiel PMI) — puis cinq ans chez Deloitte en excellence opérationnelle et externalisation de fonctions
            support (finance, compta, paie, administratif…).
          </p>
          <p>
            En 2023, j'ai fondé Ycompris autour de la CSRD : normes, audit, formation d'auditeurs. J'avais aussi fondé
            Sustain Audit, que nous avons fermé. La simplification européenne (omnibus) a cassé ce plan d'affaires.
          </p>
          <p>
            Je me suis alors tourné vers l'IA : livre <em>Garder la main</em> (Librinova, 2026), série dans le JDN,
            étude sur le traitement de l'IA dans les DEU du CAC&nbsp;40 (Investir / Les Echos).
          </p>
          <p>
            Installé en Bretagne depuis 2024, je redémarre. L'expertise réglementaire reste un arrière-plan crédible — ce
            n'est plus l'offre principale.
          </p>
          <p><em>Yves Cavarec — Fondateur Ycompris</em></p>
        </div>
      </div>
    </section>

    <section class="section cta container">
      <h2>Un sujet IA à cadrer ?</h2>
      <p>Expliquez votre contexte : décisions, risques, dépendances. On regarde ce qui est utile — sans slide deck.</p>
      <p>
        <a href="/contact" class="btn btn--primary">Me contacter →</a>
      </p>
    </section>
  </main>
</MainLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #e6f4f4 0%, #d9f0f0 100%);
    padding: 6rem 0 4rem;
    text-align: center;
  }

  .lead {
    font-size: 1.3rem;
    max-width: 800px;
    margin: 1.5rem auto 0;
  }

  .section--alt {
    background: var(--light);
  }

  ul {
    list-style: none;
    padding-left: 0;
  }

  ul li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  ul li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  .founder-bio {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .founder-text {
    flex: 1;
    min-width: 300px;
  }

  .protected-portrait {
    position: relative;
    width: 300px;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
  }

  .photo-bg {
    position: absolute;
    inset: 0;
    background: url('/images/Yves-Cavarec-CSRD-VSME-Bretagne.png') center/cover no-repeat;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: transparent;
    cursor: default;
  }

  .cta {
    text-align: center;
    background: var(--primary);
    color: white;
    border-radius: var(--radius);
    padding: 4rem 2rem;
  }

  .cta h2 {
    color: white;
  }

  .cta .btn {
    background: white;
    color: var(--primary);
    font-size: 1.2rem;
    padding: 1rem 2rem;
  }

  .cta .btn:hover {
    background: var(--primary-dark);
    color: white;
  }

  @media (max-width: 768px) {
    .founder-bio {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .protected-portrait {
      width: 200px;
      height: 340px;
      margin: 0 auto 2rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const protectedZone = document.querySelector('.protected-portrait');
    if (protectedZone) {
      protectedZone.addEventListener('contextmenu', (e) => e.preventDefault());
      protectedZone.addEventListener('dragstart', (e) => e.preventDefault());
      protectedZone.addEventListener('selectstart', (e) => e.preventDefault());
      protectedZone.querySelector('.photo-overlay')?.addEventListener('contextmenu', (e) => e.preventDefault());
    }
  });
</script>
