---
// src/pages/expertise.astro
import MainLayout from '../layouts/MainLayout.astro';

const pageTitle = 'Cabinet — Excellence opérationnelle & gouvernance | Ycompris';
const pageDescription =
  "Ycompris : gouvernance des données et IA, communication extra-financière, excellence opérationnelle. Transformer l'incertitude en avantage compétitif.";
const canonical = 'https://ycompris.com/expertise/';
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <header class="page-hero container">
    <h1>Ycompris – Excellence Opérationnelle et Gouvernance</h1>
    <p class="lead">Transformer l'incertitude en avantage compétitif.</p>
  </header>

  <main>
    <section class="section container" id="domaines">
      <h2>Mes domaines d'intervention</h2>

      <h3>Gouvernance des données et IA</h3>
      <p>
        L'IA ne doit pas être une «&nbsp;boîte noire&nbsp;» dans l'entreprise. J'accompagne les comités de direction
        pour&nbsp;:
      </p>
      <ul>
        <li>Définir une charte d'usage des outils génératifs.</li>
        <li>Auditer les processus à risque (support, juridique, communication).</li>
        <li>Poser un cadre décisionnel clair&nbsp;: qui valide quoi&nbsp;?</li>
      </ul>

      <h3>Stratégie &amp; Communication Extra-financière</h3>
      <p>
        Rendre compte de la complexité aux parties prenantes (actionnaires, salariés) est un défi majeur. Je vous aide à
        structurer vos rapports annuels et vos communications pour donner du sens à vos transformations, en alignant
        technique et humanisme.
      </p>

      <h3>Excellence Opérationnelle</h3>
      <p>
        Retrouver de la marge de manœuvre. J'interviens sur des chantiers ciblés pour débloquer des situations
        complexes, optimiser des processus et réduire les frictions organisationnelles.
      </p>
    </section>

    <section class="section section--alt container" id="pourquoi">
      <h2>Pourquoi travailler avec Ycompris&nbsp;?</h2>
      <ul class="why-list">
        <li>
          <strong>Pragmatisme</strong>&nbsp;: Pas de théorie sans application. Je teste et je valide.
        </li>
        <li>
          <strong>Indépendance</strong>&nbsp;: Aucun lien d'intérêt avec les éditeurs de logiciels. Mon conseil est
          neutre.
        </li>
        <li>
          <strong>Expérience</strong>&nbsp;: Des années d'analyse des grands groupes pour votre bénéfice.
        </li>
      </ul>
    </section>

    <section class="section section--alt container" id="fondateur">
      <h2>Yves Cavarec, fondateur d'Ycompris</h2>
      <div class="founder-bio">
        <div class="protected-portrait">
          <div class="photo-bg"></div>
          <img
            src="/images/Yves-Cavarec-CSRD-VSME-Bretagne.png"
            alt="Yves Cavarec — fondateur Ycompris, auteur de Garder la main"
            style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); opacity: 0;"
            aria-hidden="true"
          />
          <div class="photo-overlay"></div>
        </div>
        <div class="founder-text">
          <p>
            Spécialiste de la gouvernance et de la communication financière, j'ai fondé Ycompris pour aider les
            dirigeants à garder la main — sur l'IA comme sur le reste. Analyses publiques (livre, étude CAC&nbsp;40,
            presse) et accompagnement ciblé, sans catalogue de clients inventés.
          </p>
          <p><em>Yves Cavarec — Fondateur Ycompris</em></p>
        </div>
      </div>
    </section>

    <section class="section cta container">
      <h2>Un audit stratégique&nbsp;?</h2>
      <p>Expliquez votre contexte&nbsp;: décisions, risques, dépendances. On regarde ce qui est utile.</p>
      <p>
        <a href="/contact" class="btn btn--primary">Prendre rendez-vous pour un audit stratégique</a>
      </p>
    </section>
  </main>
</MainLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--light) 0%, #e8f0f5 55%, #dce8f0 100%);
    padding: 6rem 0 4rem;
    text-align: center;
  }

  .lead {
    font-size: 1.3rem;
    max-width: 800px;
    margin: 1.5rem auto 0;
    color: var(--text);
  }

  .section--alt {
    background: var(--light);
  }

  ul {
    list-style: none;
    padding-left: 0;
  }

  ul li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  ul li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  .why-list {
    max-width: 720px;
  }

  h3 {
    margin-top: 2rem;
  }

  .founder-bio {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .founder-text {
    flex: 1;
    min-width: 300px;
  }

  .protected-portrait {
    position: relative;
    width: 300px;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
  }

  .photo-bg {
    position: absolute;
    inset: 0;
    background: url('/images/Yves-Cavarec-CSRD-VSME-Bretagne.png') center/cover no-repeat;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: transparent;
    cursor: default;
  }

  .cta {
    text-align: center;
    background: var(--primary);
    color: white;
    border-radius: var(--radius);
    padding: 4rem 2rem;
  }

  .cta h2 {
    color: white;
  }

  .cta .btn {
    background: white;
    color: var(--primary);
    font-size: 1.15rem;
    padding: 1rem 2rem;
  }

  .cta .btn:hover {
    background: var(--primary-dark);
    color: white;
  }

  @media (max-width: 768px) {
    .founder-bio {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .protected-portrait {
      width: 200px;
      height: 340px;
      margin: 0 auto 2rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const protectedZone = document.querySelector('.protected-portrait');
    if (protectedZone) {
      protectedZone.addEventListener('contextmenu', (e) => e.preventDefault());
      protectedZone.addEventListener('dragstart', (e) => e.preventDefault());
      protectedZone.addEventListener('selectstart', (e) => e.preventDefault());
      protectedZone.querySelector('.photo-overlay')?.addEventListener('contextmenu', (e) => e.preventDefault());
    }
  });
</script>
