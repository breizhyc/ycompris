---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Ycompris — Excellence opérationnelle';
const description =
  'Conseil en excellence opérationnelle. Yves Cavarec, Brest. Process, décisions, IA quand elle a sa place. Chantiers bornés.';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yves Cavarec',
  jobTitle: 'Conseil en excellence opérationnelle',
  url: 'https://ycompris.com/',
  sameAs: [
    'https://www.linkedin.com/in/cavarec',
    'https://www.librinova.com/librairie/yves-cavarec/garder-la-main',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Ycompris SAS',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brest',
    addressRegion: 'Bretagne',
    addressCountry: 'FR',
  },
};
---

<MainLayout
  title={title}
  description={description}
  ogType="website"
  ogImage="/images/og-home-2026.jpg"
  ogImageAlt="Ycompris — Excellence opérationnelle, Yves Cavarec, Brest"
  canonical="https://ycompris.com/"
>
  <script slot="head-extra" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <div class="container">
    <section class="page-hero" aria-labelledby="home-title">
      <p class="eyebrow">Conseil · Brest</p>
      <h1 id="home-title">Remettre de l’ordre dans ce qui tourne déjà.</h1>
      <p class="lead">
        J’interviens sur l’excellence opérationnelle&nbsp;: process, frictions, décisions, et l’usage de l’IA quand elle y a sa place. Pas de grande transformation. Un cadre clair, un chantier borné.
      </p>
      <div class="cta-row">
        <a href="/offre/" class="btn btn--primary">L’offre</a>
        <a href="/about/" class="btn btn--ghost">Qui je suis</a>
      </div>
    </section>

    <section class="section" aria-labelledby="quoi-title">
      <h2 id="quoi-title">Ce que je fais</h2>

      <div class="card-list">
        <article class="card">
          <h3>Process et frictions</h3>
          <p>
            Repérer où le travail se bloque, se double ou échappe. Remettre un fonctionnement lisible, à l’échelle de l’équipe concernée.
          </p>
        </article>

        <article class="card">
          <h3>Décisions et responsabilités</h3>
          <p>
            Qui valide quoi. Ce qui remonte, ce qui reste local. Moins de réunions floues, plus de règles d’arrêt.
          </p>
        </article>

        <article class="card">
          <h3>IA, là où c’est utile</h3>
          <p>
            Charte d’usage, données qui peuvent sortir, mesure d’un gain réel. L’outil suit le process, pas l’inverse.
          </p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="comment-title">
      <h2 id="comment-title">Comment on travaille</h2>
      <p>
        Un échange pour voir s’il y a matière. Puis un périmètre écrit&nbsp;: objet, durée, livrable. J’interviens seul. Je ne vends pas de logiciel. Je ne construis pas une dépendance.
      </p>
      <div class="card-list">
        <article class="card">
          <h3>Cœur</h3>
          <p>Ce qui doit rester décidé par vous.</p>
        </article>
        <article class="card">
          <h3>Tête</h3>
          <p>Risques, coûts, habitudes à ne pas laisser s’installer.</p>
        </article>
        <article class="card">
          <h3>Main</h3>
          <p>Un process visible, avec un début et une fin.</p>
        </article>
      </div>
    </section>

    <section class="closing" aria-labelledby="open-title">
      <h2 id="open-title">Si un chantier est ouvert</h2>
      <p>
        Décrivez la situation en quelques lignes. On verra si je peux être utile.
      </p>
      <div class="cta-row">
        <a href="/contact/" class="btn btn--primary">Écrire</a>
      </div>
    </section>
  </div>
</MainLayout>
