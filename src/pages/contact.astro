---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Contact — Ycompris';
const description =
  'Contactez Yves Cavarec / Ycompris. Décrivez la situation en quelques lignes. Réponse sous 48 h ouvrées.';
const canonical = 'https://ycompris.com/contact/';
---

<MainLayout title={title} description={description} canonical={canonical}>
  <div class="content-wrapper">
    <p class="eyebrow">Contact</p>
    <h1>Contact</h1>
    <p>
      Décrivez la situation en quelques lignes. On verra si je peux être utile. Je réponds en principe sous 48&nbsp;h ouvrées.
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      action="/merci/"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />

      <p class="honeypot" style="display: none;">
        <label>Ne remplis pas ce champ : <input type="text" name="bot-field" /></label>
      </p>

      <div class="form-group">
        <label for="nom">Nom <span class="required">*</span></label>
        <input type="text" id="nom" name="nom" required placeholder="Votre nom" />
      </div>

      <div class="form-group">
        <label for="entreprise">Entreprise <span class="required">*</span></label>
        <input type="text" id="entreprise" name="entreprise" required placeholder="Nom de votre entreprise" />
      </div>

      <div class="form-group">
        <label for="email">Email <span class="required">*</span></label>
        <input type="email" id="email" name="email" required placeholder="votre@email.com" />
      </div>

      <div class="form-group">
        <label for="texte">Votre message <span class="required">*</span></label>
        <textarea id="texte" name="texte" rows="6" required placeholder="Décrivez la situation…"></textarea>
      </div>

      <div class="form-group checkbox">
        <label>
          <input type="checkbox" name="acceptation" required />
          J’accepte que mes données soient traitées conformément à la
          <a href="/politique-confidentialite/">Politique de confidentialité</a>
        </label>
      </div>

      <div data-netlify-recaptcha="true" style="margin: 1.5rem 0;"></div>

      <button type="submit" class="submit-btn">Envoyer</button>
    </form>

    <p class="coords">Siège&nbsp;: 6 rue Portsrein, 29200 Brest</p>
  </div>
</MainLayout>

<style>
  .contact-form {
    max-width: 560px;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .form-group {
    margin-bottom: 1.35rem;
  }

  label {
    display: block;
    margin-bottom: 0.45rem;
    font-weight: 700;
    color: var(--ink);
    font-size: 0.95rem;
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 1rem;
    font-family: var(--font-sans);
    background: #fff;
    color: var(--ink);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(44, 74, 62, 0.18);
  }

  .required {
    color: #8b3a2a;
  }

  .checkbox {
    margin: 1.35rem 0;
    font-size: 0.92rem;
  }

  .checkbox label {
    font-weight: 400;
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .checkbox input {
    margin-top: 0.25rem;
  }

  .submit-btn {
    background: var(--accent);
    color: var(--paper);
    border: none;
    padding: 0.85rem 1.6rem;
    font-size: 1rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 700;
    font-family: var(--font-sans);
    transition: background 0.15s ease;
  }

  .submit-btn:hover {
    background: var(--accent-soft);
  }

  .coords {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .contact-form {
      padding: 1.1rem;
    }
  }
</style>
