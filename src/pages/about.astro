---
import MainLayout from '../layouts/MainLayout.astro';

const title = "À propos — Yves Cavarec | Ycompris";
const description =
  "Ycompris, fondé par Yves Cavarec — auteur de Garder la main. Redémarrage en Bretagne autour de la gouvernance de l'IA.";
const canonical = 'https://ycompris.com/about/';
---

<MainLayout title={title} description={description} canonical={canonical}>
  <section class="section container">
    <h1>À propos</h1>

    <p style="font-size: 1.25rem; line-height: 1.7; max-width: 800px; margin: 0 auto 3rem;">
      Ycompris, c'est Yves Cavarec : après un parcours en transformation et excellence opérationnelle, un passage par la
      CSRD, puis un pivot net vers l'IA avec <em>Garder la main</em>. Redémarrage assumé, ancré en Bretagne.
    </p>

    <div style="display: flex; flex-wrap: wrap; gap: 2rem; justify-content: center; margin: 4rem 0;">
      <div style="flex: 1 1 300px; min-width: 300px;">
        <h2>Mission aujourd'hui</h2>
        <p>
          Aider les dirigeants à <strong>garder la main</strong> sur les décisions à l'ère de l'IA : comprendre,
          cadrer, piloter — avec des analyses utiles et, idéalement bientôt, un outil ou service clé en main.
        </p>
        <p>
          Le conseil pur n'est pas l'objectif final. L'expertise réglementaire (reporting, conformité) reste un
          arrière-plan, pas la vitrine.
        </p>
      </div>

      <div style="flex: 1 1 300px; min-width: 300px;">
        <h2>Ce qui me distingue</h2>
        <ul style="padding-left: 0; list-style: none;">
          <li style="margin-bottom: 1rem;">✓ Culture grand compte + pragmatisme terrain</li>
          <li style="margin-bottom: 1rem;">✓ Écrits publics : livre, étude CAC40, presse</li>
          <li style="margin-bottom: 1rem;">✓ Pas de clients fictifs — redémarrage transparent</li>
          <li style="margin-bottom: 1rem;">✓ Ancrage Bretagne, regard national / européen</li>
        </ul>
      </div>
    </div>

    <h2>Parcours</h2>

    <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start;">
      <div style="flex: 0 0 280px;">
        <img
          src="/images/Yves-Cavarec-CSRD-VSME-Bretagne.png"
          alt="Yves Cavarec, fondateur Ycompris, auteur de Garder la main"
          style="width: 100%; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.1);"
        />
      </div>

      <div style="flex: 1; min-width: 300px;">
        <p>
          <strong>Transformation</strong> — 15&nbsp;ans en gestion de projet, programme et portefeuille (PMI) auprès de
          grandes entreprises.
        </p>
        <p>
          <strong>Deloitte</strong> — 5&nbsp;ans en excellence opérationnelle et externalisation de fonctions support.
        </p>
        <p>
          <strong>Ycompris &amp; CSRD</strong> — fondation en 2023 autour des normes de durabilité ; Sustain Audit fondé
          puis fermé ; plan cassé par la simplification UE / omnibus.
        </p>
        <p>
          <strong>Pivot IA</strong> — <em>Garder la main</em>, tribune / série JDN, étude CAC40 (Investir / Les Echos).
          Retour en Bretagne en 2024. Aujourd'hui : repartir de zéro, sur ce qui compte.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 4rem;">
      <a href="/contact" class="btn btn--primary" style="font-size: 1.3rem; padding: 1.2rem 2.5rem;">
        Discutons de votre sujet IA
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .section {
    padding: 6rem 0;
  }
</style>
