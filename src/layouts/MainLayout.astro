---
// src/layouts/MainLayout.astro
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'Ycompris — Excellence opérationnelle',
  description = 'Conseil en excellence opérationnelle. Yves Cavarec, Brest. Process, décisions, IA quand elle a sa place. Chantiers bornés.',
  ogType = 'website',
  ogImage = '/images/og-home-2026.jpg',
  ogImageAlt = 'Ycompris — Excellence opérationnelle, Yves Cavarec, Brest',
  canonical,
  noindex = false,
} = Astro.props;

const SITE_BASE = Astro.site ?? new URL('https://ycompris.com');
const currentURL = new URL(Astro.url?.pathname ?? '/', SITE_BASE).href;
const canonicalURL = canonical ?? currentURL;
const ogImageURL = new URL(ogImage, SITE_BASE).href;
const pathname = Astro.url?.pathname ?? '/';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
    rel="stylesheet"
  />
  <link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
  <link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:url" content={currentURL} />
  <meta property="og:site_name" content="Ycompris" />
  <meta property="og:locale" content="fr_FR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Ycompris",
    "url": "https://ycompris.com",
    "logo": "https://ycompris.com/images/Ycompris.jpg",
    "description": "Conseil en excellence opérationnelle. Process, décisions, IA quand elle a sa place. Basé à Brest.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Brest",
      "addressRegion": "Bretagne",
      "addressCountry": "FR"
    },
    "email": "contact@ycompris.com",
    "sameAs": [
      "https://www.linkedin.com/in/cavarec",
      "https://www.linkedin.com/company/ycompris"
    ],
    "founder": {
      "@type": "Person",
      "name": "Yves Cavarec"
    },
    "areaServed": ["Bretagne", "France"]
  })} />

  <slot name="head-extra" />

  <style is:global>
    @font-face {
      font-family: 'Atkinson';
      src: url('/fonts/atkinson-regular.woff') format('woff');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'Atkinson';
      src: url('/fonts/atkinson-bold.woff') format('woff');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --paper: #F6F1E8;
      --ink: #1C1A16;
      --accent: #2C4A3E;
      --accent-soft: #3d6354;
      --muted: #5c574e;
      --line: #d9d0c3;
      --card: #fffcf7;
      --radius: 6px;
      --font-serif: 'Source Serif 4', 'Georgia', 'Times New Roman', serif;
      --font-sans: 'Atkinson', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--font-sans);
      background: var(--paper);
      color: var(--ink);
      line-height: 1.65;
      font-size: 1.05rem;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    a {
      color: var(--accent);
    }

    a:hover {
      color: var(--accent-soft);
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .content-wrapper {
      max-width: 720px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    @media (max-width: 768px) {
      .content-wrapper {
        padding: 1.75rem 1.15rem 3rem;
      }
    }

    h1, h2, h3 {
      font-family: var(--font-serif);
      color: var(--ink);
      line-height: 1.25;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    h1 {
      font-size: clamp(1.85rem, 4vw, 2.45rem);
      margin: 0 0 1.25rem;
    }

    h2 {
      font-size: clamp(1.35rem, 2.8vw, 1.7rem);
      margin: 2.75rem 0 1rem;
    }

    h3 {
      font-size: 1.15rem;
      margin: 1.75rem 0 0.6rem;
    }

    p {
      margin: 0 0 1.1rem;
    }

    .eyebrow {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 0.85rem;
    }

    .lead {
      font-size: 1.15rem;
      color: var(--muted);
      max-width: 38rem;
    }

    /* Header */
    .site-header {
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .header-inner {
      max-width: 920px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .wordmark {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    .wordmark:hover {
      color: var(--accent);
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 0.15rem 1.35rem;
      flex-wrap: wrap;
    }

    .site-nav a {
      color: var(--ink);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      padding: 0.2rem 0;
      border-bottom: 2px solid transparent;
    }

    .site-nav a:hover {
      color: var(--accent);
    }

    .site-nav a[aria-current="page"] {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 0.7rem 1.35rem;
      border-radius: var(--radius);
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      border: 1.5px solid transparent;
      font-family: var(--font-sans);
    }

    .btn--primary {
      background: var(--accent);
      color: var(--paper);
    }

    .btn--primary:hover {
      background: var(--accent-soft);
      color: var(--paper);
    }

    .btn--ghost {
      background: transparent;
      color: var(--accent);
      border-color: var(--accent);
    }

    .btn--ghost:hover {
      background: var(--accent);
      color: var(--paper);
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem 1.1rem;
      margin: 1.75rem 0 0;
    }

    /* Page sections */
    .page-hero {
      padding: 3.25rem 0 1.5rem;
    }

    .section {
      padding: 0.5rem 0 1rem;
    }

    .card-list {
      display: grid;
      gap: 1.25rem;
      margin: 1.5rem 0 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.35rem 1.4rem;
    }

    .card h3 {
      margin-top: 0;
    }

    .card p:last-child {
      margin-bottom: 0;
    }

    .steps {
      list-style: none;
      padding: 0;
      margin: 1.25rem 0 0;
      counter-reset: step;
    }

    .steps li {
      position: relative;
      padding: 0.85rem 0 0.85rem 2.75rem;
      border-bottom: 1px solid var(--line);
      counter-increment: step;
    }

    .steps li:last-child {
      border-bottom: none;
    }

    .steps li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      top: 0.85rem;
      width: 1.85rem;
      height: 1.85rem;
      border-radius: 50%;
      background: var(--accent);
      color: var(--paper);
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-sans);
    }

    .closing {
      margin-top: 3rem;
      padding: 1.75rem 1.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
    }

    .closing h2 {
      margin-top: 0;
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--line);
      margin-top: 3rem;
      padding: 2rem 1.5rem 2.5rem;
      background: var(--paper);
      color: var(--muted);
      font-size: 0.9rem;
    }

    .footer-inner {
      max-width: 920px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      justify-content: space-between;
      align-items: baseline;
    }

    .footer-meta {
      margin: 0;
      color: var(--ink);
      font-weight: 500;
    }

    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.15rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer-nav a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer-nav a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .cm-wrapper .cm-btn {
      background-color: var(--accent) !important;
      color: var(--paper) !important;
      border-radius: var(--radius) !important;
    }

    .cm-wrapper .cm-btn:hover {
      background-color: var(--accent-soft) !important;
    }

    @media (max-width: 640px) {
      .header-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .site-nav {
        gap: 0.35rem 1rem;
      }

      .page-hero {
        padding-top: 2.25rem;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="wordmark" aria-label="Accueil Ycompris">Ycompris</a>
      <nav class="site-nav" aria-label="Navigation principale">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Accueil</a>
        <a href="/offre/" aria-current={pathname.startsWith('/offre') ? 'page' : undefined}>Offre</a>
        <a href="/about/" aria-current={pathname.startsWith('/about') ? 'page' : undefined}>À propos</a>
        <a href="/contact/" aria-current={pathname.startsWith('/contact') ? 'page' : undefined}>Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-meta">Ycompris · SAS · Brest</p>
      <ul class="footer-nav">
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/politique-confidentialite/">Confidentialité</a></li>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li>
          <a href="https://glm.ycompris.com/" target="_blank" rel="noopener noreferrer">
            Garder la main
          </a>
        </li>
      </ul>
    </div>
  </footer>

  <CookieConsent />
</body>
</html>
